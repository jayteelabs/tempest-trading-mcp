# =============================================================================
# Tempest TradingView MCP — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
#
# This is a READ-ONLY market data server — no API keys required.

# =============================================================================
# Data Source Settings
# =============================================================================
# Yahoo Finance cache TTL in seconds
TEMPEST_YF_CACHE_TTL=3600

# Default CCXT exchange for real-time quotes (binance, bybit)
TEMPEST_CCXT_DEFAULT_EXCHANGE=binance

# Reddit adapter base URL (ENG-130 interim workaround)
# Routes Reddit sentiment fetches through the VPS-side reddit-adapter service.
# When this app runs inside Docker, use Docker's host-gateway alias so the
# container can reach the adapter bound on the VPS host.
REDDIT_ADAPTER_URL=http://host.docker.internal:8080

# =============================================================================
# Application Settings
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
TEMPEST_LOG_LEVEL=INFO

# The server always runs the HTTP/SSE transport on port 9001.
